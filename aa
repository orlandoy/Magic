import dash
from dash import dcc, html, dash_table
import plotly.graph_objects as go
import pandas as pd
import os

class ProjectDashboard:
    def __init__(self):
        self.COLOR_SCHEME = {
            "已完成": ["#2ECC71", "#27AE60"],
            "未完成": ["#E74C3C", "#C0392B"],
            "background": "#F8F9FA",
            "card": "#FFFFFF",
            "text": "#2C3E50",
            "highlight": "#3498DB"
        }
        
        # 修改为适合部署的初始化方式
        self.app = dash.Dash(__name__, 
                           external_stylesheets=[
                               'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css',
                               'https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap'
                           ],
                           serve_locally=True)
        
        self.app.title = "A2项目数据看板"  # 设置浏览器标签标题
        self.projects = self.load_projects()
        self.df = pd.DataFrame(self.projects)
        self.app.layout = self.create_layout()
    
    # 其他方法保持不变...
    # (保留原有的 load_projects, create_bar_chart, create_card 等方法)

    def get_app(self):
        """获取Dash应用实例供部署使用"""
        return self.app.server  # 关键修改：返回Flask服务器实例

# 创建应用实例
dashboard = ProjectDashboard()
app = dashboard.get_app()  # 获取WSGI应用

if __name__ == "__main__":
    # 本地开发时使用
    dashboard.run(debug=False, host="0.0.0.0", port=int(os.environ.get("PORT", 8050)))
